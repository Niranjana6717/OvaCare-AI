# =============================================================================
# OvaCare AI — Environment Configuration Template
# Copy to `.env` and fill in real values. NEVER commit the real `.env` file.
# =============================================================================

# --- Environment ---
ENVIRONMENT=development          # development | staging | production

# --- Database ---
DATABASE_URL=postgresql+psycopg2://ovacare:ovacare@localhost:5432/ovacare_db
DATABASE_URL_TEST=sqlite:///./test.db

# --- Auth / JWT ---
JWT_SECRET=change-me-to-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- API ---
API_BASE_URL=http://localhost:8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- ML ---
MODEL_PATH=./ml-platform/models/production
MODEL_REGISTRY_PATH=./ml-platform/models

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=60

# --- Notifications (future real provider integration) ---
# OvaCare's notification SERVICE and scheduling logic are implemented for real;
# actual push delivery requires a provider. Leave unset in dev — sends are logged, not delivered.
FCM_SERVER_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=

# --- Email (password reset / verification) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=no-reply@ovacare.example

# --- Admin ---
# Read by `python backend/scripts/bootstrap_admin.py` (run manually, once,
# against a target database) to create or promote exactly this account to
# the admin role. Not read by the API process — there is no HTTP endpoint
# that grants admin, by design. Leave both blank to skip bootstrap.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
